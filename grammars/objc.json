{
  "name": "OBJC",
  "scopeName": "source.objc",
  "type": "tree-sitter",
  "parser": "tree-sitter-objc",
  "injectionNames": ["objc", "obj-c", "objective-c", "objectivec"],
  "contentRegex": "^(?:\\s|//[^\\r\\n]*(?:\\r?\\n|$)|/\\*(?:[^*]|\\*(?!/))*\\*/|#[ \\t]*include\\b[^\\\\\\r\\n]*(?:\\r?\\n|$)|#[ \\t]*pragma[ \\t]+once[ \\t]*(?:\\r?\\n|$))*(?:#[ \\t]*import\\b|@(?:interface|implementation|protocol|property|class|import)\\b)",
  "fileTypes": ["m", "h", "pch", "x", "xm", "xmi"],
  "comments": {
    "start": "// "
  },
  "treeSitter": {
    "parserSource": "github:amaanq/tree-sitter-objc#v3.0.2",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "objc.wasm",
    "tagsQuery": "objc-tags.scm",
    "highlightsQuery": "objc-highlights.scm",
    "indentsQuery": "objc-indents.scm",
    "localsQuery": "objc-locals.scm",
    "foldsQuery": "objc-folds.scm"
  }
}
