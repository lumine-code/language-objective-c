{
  "name": "OBJC",
  "scopeName": "source.objc",
  "type": "tree-sitter",
  "parser": "tree-sitter-objc",
  "injectionNames": ["objc", "objective-c"],
  "contentRegex": "^\\s*(#import|#include|@interface|@implementation|@property)",
  "fileTypes": ["m", "h", "pch", "x", "xm", "xmi"],
  "comments": {
    "start": "// "
  },
  "treeSitter": {
    "parserSource": "github:amaanq/tree-sitter-objc#v3.0.2",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "objc.wasm",
    "highlightsQuery": "objc-highlights.scm",
    "localsQuery": "objc-locals.scm",
    "foldsQuery": "objc-folds.scm"
  }
}
